{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python314",
      "ignore": [
        ".venv",
        "venv",
        "__pycache__",
        "*.pyc",
        ".secret.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  }
}
